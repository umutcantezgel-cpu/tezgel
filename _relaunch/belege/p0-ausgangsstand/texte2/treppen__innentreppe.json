  {"art":"text","wert":"Normgerechte Verbundabdichtung nach DIN 18534"},
  {"art":"text","wert":"Lückenlose Abdichtungsbahnen und Dichtmanschetten in Nassräumen für dauerhafte Dichtigkeit und Schimmelschutz."},
  {"art":"text","wert":"Garantierter Standard"},
