{
  "multipass": true,
  "plugins": [
    {
      "name": "preset-default",
      "params": {
        "overrides": {
          "removeUnknownsAndDefaults": {
            "keepRoleAttr": true
          },
          "mergePaths": false,
          "collapseGroups": false,
          "convertShapeToPath": false,
          "cleanupIds": {
            "minify": false,
            "remove": false,
            "preserve": [],
            "preservePrefixes": []
          },
          "inlineStyles": false
        }
      }
    }
  ]
}
