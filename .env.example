# Fliesenverlegung Tezgel - Umgebungsvariablen-Vorlage
# Kopieren Sie diese Datei zu .env.local für lokale Entwicklung oder tragen Sie
# die Werte im Hosting-Dashboard (z. B. Vercel, Hetzner, Coolify) ein.

# -----------------------------------------------------------------------------
# Resend E-Mail Pipeline (https://resend.com)
# -----------------------------------------------------------------------------
# Erforderlich für den echten E-Mail-Versand der Anfrage-Funnels.
# Im Entwicklungsmodus ohne Key loggt die API-Route die Anfrage im Mock-Modus.
RESEND_API_KEY=re_your_api_key_here

# Absenderadresse (muss in Resend verifiziert sein, z. B. auf tezgel.de)
RESEND_FROM_EMAIL="Fliesenverlegung Tezgel <info@tezgel.de>"

# Empfänger für neue Kundenanfragen
CONTACT_EMAIL=info@tezgel.de

# -----------------------------------------------------------------------------
# Webseiten-Konfiguration & Metadaten
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.tezgel.de

# -----------------------------------------------------------------------------
# Microsoft Bing / IndexNow Real-Time SEO
# -----------------------------------------------------------------------------
# Standard-Key wird automatisch aus der Root-Key-Datei geladen (4c6796df61f5479387fc4f56b1ed6b19)
INDEXNOW_KEY=4c6796df61f5479387fc4f56b1ed6b19
# Optional: Secret zum Absichern der POST /api/indexnow Route gegen unberechtigte Aufrufe
INDEXNOW_SECRET=
