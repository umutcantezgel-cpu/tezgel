     "hinzugefuegt": [
      {
       "text": "Beide Materialien sind hochwertig",
       "kontext_vor": "oder Naturstein? Der ehrliche Vergleich",
       "kontext_nach": "und langlebig, unterscheiden sich aber",
       "erlaubt": false
