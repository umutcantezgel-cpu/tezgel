diff --git a/src/lib/seo/indexierung.ts b/src/lib/seo/indexierung.ts
new file mode 100644
index 00000000..7b5a617c
--- /dev/null
+++ b/src/lib/seo/indexierung.ts
@@ -0,0 +1,32 @@
+// SEO-Runde P4 (S3, T12; docs/seo/KONTEXT.md A04): welche Adressen in den Index gehören. Seiten ohne eigenen Inhalt
+// bekommen „noindex, follow“ (Meta-robots, nicht per robots.txt gesperrt) und stehen weder in der Sitemap noch in IndexNow:
+// Die 52 Seiten Leistung × Ort und die Ortsseiten ohne eigenen Inhalt sind fast gleich (Googles Beispiel für Brückenseiten).
+// Im Index bleiben nur Ortsseiten mit eigenem Inhalt (src/inhalte/orte-eigen.ts): heute Wetzlar, die Zielseite des Auftrags
+// (Ziel 2). Weitere Orte kommen nur mit echten Angaben dazu (bestätigte Projekte, Stimmen, Stadtteile; Leitplanke Wahrheit).
+import { EIGENE_ORTSINHALTE } from '../../inhalte/orte-eigen';
+
+/** Ortsseiten mit eigenem Inhalt, abgeleitet aus EIGENE_ORTSINHALTE; alle anderen /standorte/<ort> bekommen noindex, follow */
+export const ORTE_MIT_EIGENEM_INHALT: readonly string[] = Object.keys(EIGENE_ORTSINHALTE);
+
+/** Rechtstexte mit noindex in ihrem Layout; IndexNow meldet sie nicht */
+export const RECHTSTEXTE_OHNE_INDEX: readonly string[] = ['/impressum', '/datenschutz', '/agb', '/widerruf', '/cookie-richtlinie'];
+
+/** robots für Seiten ohne eigenen Inhalt: nicht in den Index, Links aber folgen */
+export const OHNE_INDEX = { index: false, follow: true } as const;
+
+export function ortsseiteIndexiert(slug: string): boolean {
+  return ORTE_MIT_EIGENEM_INHALT.includes(slug);
+}
+
+/** Gehört die Adresse (Pfad ohne Domain) in Sitemap und IndexNow? */
+export function pfadIndexiert(pfad: string): boolean {
+  const ort = /^\/standorte\/([^/]+)\/?$/.exec(pfad);
+  if (ort) return ortsseiteIndexiert(ort[1]);
+  if (/^\/leistungen\/[^/]+\/[^/]+\/?$/.test(pfad)) return false;
+  return !RECHTSTEXTE_OHNE_INDEX.includes(pfad.replace(/\/$/, '') || '/');
+}
+
+/** Wie pfadIndexiert, für eine volle Adresse (https://www.tezgel.de/...) */
+export function adresseIndexiert(adresse: string): boolean {
+  return pfadIndexiert(new URL(adresse).pathname);
+}
