+      { name: 'Barrierefreies Bad', satz: 'Mit Pflegegrad zahlt die Pflegekasse bis zu 4.180 € je Person dazu.', href: '/bad/barrierefreies-bad', vignette: 'bad' },
+      { name: 'Böden und Wände', satz: 'Große Fliesen, Feinsteinzeug und Naturstein in Wohnräumen, Küchen und im Neubau.', href: '/leistungen/wohnen', vignette: 'wohnen' },
